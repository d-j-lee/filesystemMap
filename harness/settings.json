{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(cargo publish *)",
      "Bash(cargo yank *)",
      "Bash(cargo owner *)",
      "Bash(cargo login *)"
    ],
    "ask": [
      "Edit(/**/Cargo.toml)",
      "Edit(/deny.toml)",
      "Edit(/clippy.toml)",
      "Edit(/rust-toolchain.toml)",
      "Edit(/.cargo/**)",
      "Edit(/.claude/**)",
      "Edit(/AGENTS.md)",
      "Edit(/.github/workflows/**)",
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(cargo update *)",
      "Bash(cargo * --config *)",
      "Bash(cargo * --config=*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "fsmap", "args": ["hook", "session-start"], "timeout": 120 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "fsmap", "args": ["hook", "post-edit"], "timeout": 300 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "fsmap", "args": ["hook", "stop"], "timeout": 900 }
        ]
      }
    ]
  }
}
